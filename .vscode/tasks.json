{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Intel AVB: Build (Windows)",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoLogo","-ExecutionPolicy","Bypass","-Command","cd '$env:USERPROFILE/source/repos/intel_avb/lib'; ./build_windows.bat"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "Intel AVB: Run test_intel",
      "type": "shell",
      "dependsOn": ["Intel AVB: Build (Windows)"],
      "command": "powershell",
      "args": ["-NoLogo","-ExecutionPolicy","Bypass","-Command","cd '$env:USERPROFILE/source/repos/intel_avb/lib'; if (!(Test-Path build/test_intel.exe)) { ./build_windows.bat }; ./build/test_intel.exe"],
      "group": "test",
      "problemMatcher": []
    },
    {"label": "Intel AVB: Minimal Test","type": "shell","command": "powershell","args": ["-NoLogo","-ExecutionPolicy","Bypass","-Command","cd '$env:USERPROFILE/source/repos/intel_avb/lib'; ./test_minimal.bat"],"group": "test","problemMatcher": []},
    {"label": "Intel AVB: Simple Test","type": "shell","command": "powershell","args": ["-NoLogo","-ExecutionPolicy","Bypass","-Command","cd '$env:USERPROFILE/source/repos/intel_avb/lib'; ./test_simple.bat"],"group": "test","problemMatcher": []},
    {"label": "Intel AVB: Probe Test","type": "shell","command": "powershell","args": ["-NoLogo","-ExecutionPolicy","Bypass","-Command","cd '$env:USERPROFILE/source/repos/intel_avb/lib'; ./test_probe.bat"],"group": "test","problemMatcher": []},
  {"label": "Intel AVB: Hardware Test","type": "shell","command": "powershell","args": ["-NoLogo","-ExecutionPolicy","Bypass","-Command","cd '$env:USERPROFILE/source/repos/intel_avb/lib'; ./test_hardware.bat"],"group": "test","problemMatcher": []},
  {"label": "Intel AVB: Realmode IOCTL Test","type": "shell","dependsOn":["Intel AVB: Build (Windows)"],"command": "powershell","args": ["-NoLogo","-ExecutionPolicy","Bypass","-Command","cd '$env:USERPROFILE/source/repos/intel_avb/lib'; if (!(Test-Path build/test_realmode.exe)) { ./build_windows.bat }; ./build/test_realmode.exe"],"group": "test","problemMatcher": []}
  ]
}